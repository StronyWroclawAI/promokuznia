# Nagłówki bezpieczeństwa dla plików strony (Cloudflare Pages). Odpowiedzi API ustawiają swoje w functions/.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=(), geolocation=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://geowidget.inpost.pl https://sandbox-easy-geowidget-sdk.easypack24.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://geowidget.inpost.pl https://sandbox-easy-geowidget-sdk.easypack24.net; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.easypack24.net https://*.inpost.pl https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com https://*.inpost.pl; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Fonty nie zmieniają się — przeglądarka trzyma je rok
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Skrypty i style: krótko z pamięci, w tle sprawdzenie nowej wersji (po wdrożeniu zmiany widać po ok. 5 min)
/assets/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
